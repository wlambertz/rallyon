{
  "children": [
    {
      "id": "login-screen",
      "type": "frame",
      "x": 0,
      "y": 0,
      "width": 1440,
      "height": 1024,
      "fill": "#f5f7fb",
      "layout": "horizontal",
      "padding": [
        48,
        48,
        48,
        48
      ],
      "gap": 32,
      "children": [
        {
          "id": "login-copy",
          "type": "frame",
          "width": 760,
          "height": "fill_container",
          "layout": "vertical",
          "gap": 20,
          "children": [
            {
              "id": "login-title",
              "type": "text",
              "content": "Organizer access",
              "fill": "#0f172a",
              "fontFamily": "Space Grotesk",
              "fontSize": 48
            },
            {
              "id": "login-body",
              "type": "text",
              "content": "Import organizer-ui.lib.pen before refining this screen. Use the library for shared tokens, buttons, and status elements.",
              "fill": "#0f172a",
              "fontFamily": "IBM Plex Sans",
              "fontSize": 18,
              "width": 560
            }
          ]
        },
        {
          "id": "login-form-shell",
          "type": "frame",
          "width": 360,
          "height": "fit_content",
          "layout": "vertical",
          "padding": [
            24,
            24,
            24,
            24
          ],
          "gap": 16,
          "cornerRadius": 16,
          "fill": "#ffffff",
          "stroke": {
            "thickness": 1,
            "fill": "#e2e8f0"
          },
          "children": [
            {
              "id": "login-form-title",
              "type": "text",
              "content": "Sign in checkpoint",
              "fill": "#0f172a",
              "fontFamily": "Space Grotesk",
              "fontSize": 24
            },
            {
              "id": "login-form-note",
              "type": "text",
              "content": "Use this file as the Pencil screen source for the login route.",
              "fill": "#0f172a",
              "fontFamily": "IBM Plex Sans",
              "fontSize": 16,
              "width": 280
            }
          ]
        }
      ]
    }
  ]
}
