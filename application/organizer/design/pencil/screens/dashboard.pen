{
  "children": [
    {
      "id": "dashboard-screen",
      "type": "frame",
      "x": 0,
      "y": 0,
      "width": 1440,
      "height": 1200,
      "fill": "#f5f7fb",
      "layout": "vertical",
      "padding": [
        40,
        40,
        40,
        40
      ],
      "gap": 24,
      "children": [
        {
          "id": "dashboard-header",
          "type": "text",
          "content": "Operations board",
          "fill": "#0f172a",
          "fontFamily": "Space Grotesk",
          "fontSize": 40
        },
        {
          "id": "dashboard-note",
          "type": "text",
          "content": "Use the library file for shared action cards, status tags, and button treatments before refining this screen layout.",
          "fill": "#0f172a",
          "fontFamily": "IBM Plex Sans",
          "fontSize": 16,
          "width": 760
        },
        {
          "id": "dashboard-modules",
          "type": "frame",
          "width": "fill_container",
          "height": "fit_content",
          "layout": "horizontal",
          "gap": 24,
          "children": [
            {
              "id": "dashboard-main-panel",
              "type": "frame",
              "width": 860,
              "height": 420,
              "fill": "#ffffff",
              "cornerRadius": 16,
              "stroke": {
                "thickness": 1,
                "fill": "#e2e8f0"
              }
            },
            {
              "id": "dashboard-status-panel",
              "type": "frame",
              "width": 420,
              "height": 420,
              "fill": "#ffffff",
              "cornerRadius": 16,
              "stroke": {
                "thickness": 1,
                "fill": "#e2e8f0"
              }
            }
          ]
        }
      ]
    }
  ]
}
