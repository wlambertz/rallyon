{
  "children": [
    {
      "id": "events-screen",
      "type": "frame",
      "x": 0,
      "y": 0,
      "width": 1280,
      "height": 960,
      "fill": "#f5f7fb",
      "layout": "vertical",
      "padding": [
        40,
        40,
        40,
        40
      ],
      "gap": 24,
      "children": [
        {
          "id": "events-title",
          "type": "text",
          "content": "Events workspace",
          "fill": "#0f172a",
          "fontFamily": "Space Grotesk",
          "fontSize": 40
        },
        {
          "id": "events-body",
          "type": "text",
          "content": "Use this screen file for schedule, bracket, and field-management mockups. Import the organizer library before turning placeholders into reusable modules.",
          "fill": "#0f172a",
          "fontFamily": "IBM Plex Sans",
          "fontSize": 16,
          "width": 760
        },
        {
          "id": "events-panel",
          "type": "frame",
          "width": 760,
          "height": 420,
          "fill": "#ffffff",
          "cornerRadius": 16,
          "stroke": {
            "thickness": 1,
            "fill": "#e2e8f0"
          }
        }
      ]
    }
  ]
}
